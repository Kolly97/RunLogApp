{
  "name": "runlog",
  "version": "3.0.0",
  "buildDate": "12.07.2026",
  "private": true,
  "type": "module",
  "description": "Lokale Trainings-App: Wochenplanung, Tracking & TrainingPeaks-Auswertung",
  "author": "Kolja Hildenbrand",
  "license": "MIT",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "db:template": "tsx server/reset-db.ts training.empty.db",
    "db:reset": "tsx server/reset-db.ts data/training.db",
    "electron:bundle": "node esbuild.electron.mjs",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "electron:dev": "npm run electron:bundle && concurrently -k -n server,client,electron -c blue,green,magenta \"cross-env PORT=3000 npm:dev:server\" \"npm:dev:client\" \"cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && npm run electron:bundle && electron .",
    "electron:build": "npm run sidecar:build -- --target=darwin && npm run build && npm run electron:bundle && electron-builder --mac",
    "electron:build:win": "npm run sidecar:build -- --target=win32 && npm run build && npm run electron:bundle && electron-builder --win",
    "electron:build:linux": "npm run sidecar:build -- --target=linux && npm run build && npm run electron:bundle && electron-builder --linux",
    "app:import-data": "node scripts/import-data.mjs"
  },
  "build": {
    "appId": "de.koljahildenbrand.runlog",
    "productName": "RunLog",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron-dist/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "training.empty.db",
        "to": "seed/training.db"
      },
      {
        "from": "build/sidecar",
        "to": "sidecar"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Kolja Hildenbrand <kolja.hildenbrand@gmail.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "react-grid-layout": "^1.5.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-grid-layout": "^1.3.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
